# ============================================================
# Wander.AI — Environment Variables
# Copy this file to .env and fill in your values.
# cp .env.example .env
# ============================================================

# ── Database ──────────────────────────────────────────────────
# PostgreSQL connection string
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DB_NAME

# ── NextAuth ──────────────────────────────────────────────────
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=
# Your app URL (no trailing slash)
NEXTAUTH_URL=http://localhost:3000

# ── Google OAuth ──────────────────────────────────────────────
# Create at: https://console.cloud.google.com/apis/credentials
# Redirect URI: http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Google Gemini AI ──────────────────────────────────────────
# Get key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
# Recommended model (leave blank to use default)
GEMINI_MODEL=gemini-2.5-flash

# ── Maps ──────────────────────────────────────────────────────
# Get token at: https://account.mapbox.com/access-tokens/
# Must be a PUBLIC token (starts with pk.)
NEXT_PUBLIC_MAPBOX_TOKEN=

# ── Email (SMTP) ──────────────────────────────────────────────
# For Gmail: use App Password (not your main password)
# Guide: https://support.google.com/accounts/answer/185833
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM_NAME=Wander.AI
SMTP_FROM_EMAIL=

# ── Lemon Squeezy (Payments) ──────────────────────────────────
# Dashboard: https://app.lemonsqueezy.com/settings/api
LEMONSQUEEZY_API_KEY=
LEMONSQUEEZY_WEBHOOK_SECRET=

# ── Sentry (Error Monitoring) ─────────────────────────────────
# Create project at: https://sentry.io
# Both DSN values are the same string from Sentry dashboard
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
# Required for source map uploads during production builds
SENTRY_AUTH_TOKEN=
SENTRY_ORG=your-sentry-org-slug
SENTRY_PROJECT=wander-ai

# ── Unsplash (Cover Images) ───────────────────────────────────
# Optional — fallback images used if not set
# Register at: https://unsplash.com/developers
UNSPLASH_ACCESS_KEY=

# ── Upstash Redis (Edge Rate Limiting) ────────────────────────
# Dashboard: https://console.upstash.com/
# Free tier gives 10,000 commands/day — plenty for rate limiting
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ── Razorpay (Payments) ───────────────────────────────────────
# Create account & test keys at: https://dashboard.razorpay.com/
# KEY_SECRET must NEVER be exposed to the frontend
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
NEXT_PUBLIC_RAZORPAY_KEY_ID=
